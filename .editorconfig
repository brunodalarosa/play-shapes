root = true

[*]
charset = utf-8
end_of_line = lf

[*.gd]
indent_style = tab
indent_size = 4
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,mjs,js,html,css,json,yml,yaml}]
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,mjs,html,css}]
max_line_length = 100

# Two trailing spaces are a line break in Markdown.
[*.md]
insert_final_newline = true
