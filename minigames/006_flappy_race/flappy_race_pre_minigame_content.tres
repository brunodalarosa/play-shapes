[resource]
script = ExtResource("1")
title = "Flappy Race"
controls = "Hold your phone in portrait. Tap anywhere to flap."
win_condition = "Fly from the start line to the finish. First across wins; the rest rank by finish time, then by distance."
hints = "A hit costs a heart. Tap the floating heart to fly again. Golden coins give a short speed boost."
