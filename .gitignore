# Godot 4+ specific ignores
.godot/
.obsidian/
# The knowledge base vault keeps its shared settings; per-user Obsidian state stays out.
!KnowledgeBase/.obsidian/
KnowledgeBase/.obsidian/*
!KnowledgeBase/.obsidian/app.json
!KnowledgeBase/.obsidian/core-plugins.json
!KnowledgeBase/.obsidian/templates.json
/android/
web/node_modules/
web/build/
web/.npm-cache/
test-results/*
!test-results/.gdignore
__pycache__/
builds/
scratch/
comparisons/
BRUNO_GIT_IGNORE/
opencode.json
*.local.json
*.log
.cubio-output-*
local/
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
*.der
*.pem.tmp

# Temporary copies Windows leaves when godot-wry's loaded DLL is replaced
addons/godot_wry/bin/**/~*
